# ── Database ────────────────────────────────────────────────
# Postgres password for the containerized DB (openssl rand -hex 32)
POSTGRES_PASSWORD=

# ── Auth ────────────────────────────────────────────────────
# JWT signing key (openssl rand -hex 64)
JWT_SECRET_KEY=

# ── AI (Hugging Face Inference Providers) ───────────────────
# Token with "Make calls to Inference Providers" permission.
# Models: Qwen/Qwen3-32B (recommendations/search/roulette/match), openai/gpt-oss-120b (chat)
HF_TOKEN=

# ── TMDB ────────────────────────────────────────────────────
# TMDB v4 Read Access Token (Bearer) — same value used by the frontend.
# Used to resolve Letterboxd imports to stable TMDB ids.
TMDB_TOKEN=

# ── Deploy (Caddy) ──────────────────────────────────────────
# Public domain for the API. Caddy obtains a TLS cert for it automatically.
API_DOMAIN=api.cinematch.seu-dominio.com
